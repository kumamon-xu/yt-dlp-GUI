{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt-dlp GUI",
  "version": "0.1.0",
  "identifier": "com.ytdlp.gui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yt-dlp GUI",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0b0f14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
